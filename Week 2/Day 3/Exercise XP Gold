from datetime import datetime
import holidays

def upcoming_holiday(country_code="US"):
    today = datetime.now()
    print(f"Today's date: {today.strftime('%Y-%m-%d %H:%M:%S')}")

    # Fetch holidays for the current and next year
    year_holidays = holidays.country_holidays(country_code, years=[today.year, today.year + 1])
    
    # Find the next upcoming holiday
    upcoming = []
    for date, name in sorted(year_holidays.items()):
        holiday_dt = datetime.combine(date, datetime.min.time())
        if holiday_dt > today:
            upcoming.append((holiday_dt, name))
            break
            
    if upcoming:
        next_date, name = upcoming[0]
        time_left = next_date - today
        days = time_left.days
        hours, remainder = divmod(time_left.seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        print(f"The next holiday is {name} in {days} days, {hours} hours, and {minutes} minutes.")

upcoming_holiday()
#2 How Old Are You On Jupiter?

def calculate_age_on_planets(seconds):
    earth_years = seconds / 31557600
    
    orbital_periods = {
        "Earth": 1.0,
        "Mercury": 0.2408467,
        "Venus": 0.61519726,
        "Mars": 1.8808158,
        "Jupiter": 11.862615,
        "Saturn": 29.447498,
        "Uranus": 84.016846,
        "Neptune": 164.79132
    }
    
    print(f"Age for {seconds:,} seconds:")
    for planet, period in orbital_periods.items():
        age = earth_years / period
        print(f"  - {planet}: {age:.2f} {planet}-years old")

calculate_age_on_planets(1000000000)

