import re

def validate_name():
    pattern = r'^[A-Z][a-z]* [A-Z][a-z]*$'
    
    name = input("Please enter your full name: ")
    if re.match(pattern, name):
        print("Valid name!")
    else:
        print("Invalid name. Must contain exactly two capitalized words (only letters) separated by a single space.")

validate_name()

#5 Python Password Generator
import random
import string
import re

def generate_password(length):
    digits = string.digits
    lower = string.ascii_lowercase
    upper = string.ascii_uppercase
    special = "!@#$%^&*"
    all_chars = digits + lower + upper + special
    
    # Ensure at least 1 of each required character type
    pwd = [
        random.choice(digits),
        random.choice(lower),
        random.choice(upper),
        random.choice(special)
    ]
    
    # Fill remaining length with random choices
    pwd += random.choices(all_chars, k=length - 4)
    random.shuffle(pwd)
    return "".join(pwd)

def test_password(password, expected_length):
    if len(password) != expected_length:
        return False
    if not re.search(r'[0-9]', password):
        return False
    if not re.search(r'[a-z]', password):
        return False
    if not re.search(r'[A-Z]', password):
        return False
    if not re.search(r'[!@#$%^&*]', password):
        return False
    return True

# 100-run automated test suite
def run_tests():
    for _ in range(100):
        length = random.randint(6, 30)
        pwd = generate_password(length)
        assert test_password(pwd, length), f"Password validation failed for: {pwd}"
    print("All 100 password generation tests passed successfully!")

run_tests()

# Interactive prompt flow
def main():
    while True:
        try:
            length = int(input("Enter password length (between 6 and 30): "))
            if 6 <= length <= 30:
                break
            print("Invalid range. Must be between 6 and 30.")
        except ValueError:
            print("Invalid input. Please enter a valid number.")

    password = generate_password(length)
    print(f"\nGenerated Password: {password}")
    print("Security Reminder: Please make sure to keep your password in a safe place!")

main()