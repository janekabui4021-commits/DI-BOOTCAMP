from datetime import datetime
import holidays
import random
import re
import secrets
import string


# Exercise 1
def upcoming_holiday(country_code="US"):
    today = datetime.now().date()
    calendar = holidays.country_holidays(
        country_code,
        years=[today.year, today.year + 1]
    )

    future_holidays = [
        (holiday_date, name)
        for holiday_date, name in calendar.items()
        if holiday_date > today
    ]

    next_date, name = min(future_holidays, key=lambda item: item[0])
    days_left = (next_date - today).days

    print(f"Today's date: {today}")
    print(f"The next holiday is {name} in {days_left} days.")


# Exercise 2
def calculate_age_on_planets(seconds):
    earth_age = seconds / 31_557_600

    orbital_periods = {
        "Earth": 1,
        "Mercury": 0.2408467,
        "Venus": 0.61519726,
        "Mars": 1.8808158,
        "Jupiter": 11.862615,
        "Saturn": 29.447498,
        "Uranus": 84.016846,
        "Neptune": 164.79132,
    }

    for planet, period in orbital_periods.items():
        print(f"{planet}: {earth_age / period:.2f} years")


# Exercise 3
def return_numbers(text):
    return "".join(re.findall(r"\d", text))


# Exercise 4
def validate_name(name):
    return bool(re.fullmatch(r"[A-Z][a-z]+ [A-Z][a-z]+", name))


# Exercise 5
def generate_password(length):
    if not 6 <= length <= 30:
        raise ValueError("Length must be between 6 and 30.")

    digits = string.digits
    lowercase = string.ascii_lowercase
    uppercase = string.ascii_uppercase
    special = "!@#$%^_&*"
    all_characters = digits + lowercase + uppercase + special

    characters = [
        secrets.choice(digits),
        secrets.choice(lowercase),
        secrets.choice(uppercase),
        secrets.choice(special),
    ]

    characters += [
        secrets.choice(all_characters)
        for _ in range(length - 4)
    ]

    secrets.SystemRandom().shuffle(characters)
    return "".join(characters)


def test_password(password, expected_length):
    assert len(password) == expected_length
    assert re.search(r"\d", password)
    assert re.search(r"[a-z]", password)
    assert re.search(r"[A-Z]", password)
    assert re.search(r"[!@#$%^_&*]", password)


def run_tests():
    for _ in range(100):
        length = random.randint(6, 30)
        password = generate_password(length)
        test_password(password, length)

    print("All 100 password tests passed!")


if __name__ == "__main__":
    upcoming_holiday()

    print("\nPlanetary ages:")
    calculate_age_on_planets(1_000_000_000)

    print("\nExtracted numbers:")
    print(return_numbers("k5k3q2g5z6x9bn"))

    name = input("\nEnter your full name: ")
    print("Valid name!" if validate_name(name) else "Invalid name.")

    run_tests()

    while True:
        try:
            length = int(input("\nEnter password length (6-30): "))

            if 6 <= length <= 30:
                break

            print("Enter a number between 6 and 30.")

        except ValueError:
            print("Enter a valid number.")

    password = generate_password(length)
    print(f"\nGenerated password: {password}")
    print("Keep your password in a safe place!")