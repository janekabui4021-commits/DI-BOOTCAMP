# Step 1: Set up the project
import random


# Step 2: Write the game logic
def number_guessing_game():
    # 2. Generate a random number between 1 and 100
    random_number = random.randint(1, 100)
    print("Welcome to the number guessing game!")

    max_attempts = 7
    for attempt in range(1, max_attempts + 1):
        guess = int(input(f"Attempt {attempt}/{max_attempts} - Enter a number between 1 and 100: "))
        print(f"You guessed: {guess}")

        if guess < random_number:
            print("Too low!")
        elif guess > random_number:
            print("Too high!")
        else:
            print(
                f"Congratulations! You guessed the correct number ({random_number})!"
            )
            break
    #  Reveal the number if the player runs out of attempts
    else:
        print(
            f"Sorry, you've used all your attempts! The correct number was {random_number}."
        )


# Run the function
number_guessing_game()