<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f2ec">
  <title><%= typeof pageTitle === 'string' ? pageTitle : 'RSS Facts Feed' %></title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  >
  <style>
    :root {
      color-scheme: light;
      --ink: #202521;
      --muted: #60675f;
      --forest: #225b48;
      --paper: #f4f2ec;
      --line: #d7d8cf;
      font-family: system-ui, sans-serif;
    }

    body {
      min-height: 100vh;
      color: var(--ink);
      background-color: var(--paper);
      background-image: radial-gradient(#d6d6cb 0.7px, transparent 0.7px);
      background-size: 18px 18px;
    }

    .site-header,
    .site-footer {
      background: #fffefa;
    }

    .site-header {
      border-bottom: 1px solid var(--line);
    }

    .brand-mark {
      color: var(--forest);
      font-weight: 700;
    }

    .page-shell {
      width: min(100% - 32px, 920px);
      margin: 0 auto;
      padding: 40px 0 64px;
    }

    .page-heading {
      margin-bottom: 28px;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--forest);
      font: 500 12px ui-monospace, monospace;
      text-transform: uppercase;
    }

    .page-heading h1 {
      margin: 0;
      font-size: 36px;
      font-weight: 700;
    }

    .page-heading p:last-child {
      color: var(--muted);
    }

    .search-panel,
    .post-item {
      padding: 20px;
      border: 1px solid var(--line);
      border-top: 3px solid var(--forest);
      background: #fffefa;
    }

    .search-panel {
      margin-bottom: 20px;
    }

    .search-form {
      display: grid;
      gap: 10px;
    }

    .post-list {
      display: grid;
      gap: 14px;
    }

    .post-item h2 {
      margin: 0 0 10px;
      font-size: 22px;
    }

    .post-item h2 a {
      color: var(--forest);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      color: var(--muted);
      font-size: 14px;
    }

    .post-content {
      margin: 14px 0 0;
      line-height: 1.65;
      overflow-wrap: anywhere;
    }

    .notice {
      padding: 12px 16px;
      border-left: 3px solid var(--forest);
      background: #fffefa;
    }

    .site-footer {
      padding: 18px 16px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      text-align: center;
    }

    @media (max-width: 575px) {
      .page-shell {
        padding-top: 30px;
      }

      .page-heading h1 {
        font-size: 30px;
      }

      .search-panel,
      .post-item {
        padding: 16px;
      }
    }
  </style>
</head>